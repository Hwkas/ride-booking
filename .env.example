# Application
APP_NAME="Ride Booking API"
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ride_booking
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ride_booking_test

# Auth (generate a secret with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fare
FARE_BASE=2.50
FARE_PER_KM=1.20

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
