# Copy to .env and fill in real values. NEVER commit the real file.
# All settings are declared in app/core/config.py.

# Application
APP_NAME="Ride Booking API"
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

# Postgres container (deploy/compose.yml)
POSTGRES_USER=ride
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ride_booking
PGWEB_DATABASE_URL=postgres://ride:change-me@db:5432/ride_booking?sslmode=disable

# Database (psycopg3 driver; serves both the async and sync engines).
# localhost for `make run_dev`; compose overrides the host to `db` for the api.
DATABASE_URL=postgresql+psycopg://ride:change-me@localhost:5432/ride_booking
DB_ECHO=false
TEST_DATABASE_URL=postgresql+psycopg://ride:change-me@localhost:5432/ride_booking_test

# Auth (generate a secret with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fare
FARE_BASE=2.50
FARE_PER_KM=1.20

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
